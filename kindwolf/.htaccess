# Fichiers internes jamais accessibles depuis le navigateur
<FilesMatch "(^\.|config\.local.*\.php$|\.(md|sql|log|bak)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
